# JARVO environment variables — copy this file to .env and fill in real values.
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env
# NEVER commit the real .env to git (it is already in .gitignore).

# Groq API keys — https://console.groq.com/keys  (free tier)
# LLM (brain) key:
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# STT (Whisper) key — separate quota bucket so STT and LLM don't rate-limit
# each other. If omitted, falls back to GROQ_API_KEY (still works).
GROQ_API_KEY_STT=gsk_yyyyyyyyyyyyyyyyyyyy

# Gmail for email sending — needs a 2FA App Password (NOT your normal
# password). Google Account -> Security -> 2-Step Verification -> App passwords.
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=abcdefghijklmnop

# Optional shared secret for the web server (server.py). When set, every
# /api/* request must send header "X-Auth-Token: <value>" (the web UI will
# prompt for it once). Leave empty for no auth (localhost-only by default).
JARVO_TOKEN=
